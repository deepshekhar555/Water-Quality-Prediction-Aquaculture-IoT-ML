# AquaSense Pro — Environment Configuration Example
# =================================================
# This file contains placeholders only. Never commit real credentials.
# Copy to .env and fill in your values before running.

# Wi-Fi credentials
WIFI_SSID=YOUR_WIFI_NETWORK_NAME
WIFI_PASSWORD=YOUR_WIFI_PASSWORD

# AWS IoT Core endpoints and certificates (paths relative to project root)
# These are required for AWS IoT Core MQTT connectivity.
# Generate certificates via AWS IoT Console → Things → Interact → HTTPS.
AWS_IOT_ENDPOINT=YOUR_AWS_IOT_ENDPOINT.iot.YOUR_AWS_REGION.amazonaws.com
AWS_ROOT_CA=certs/root-CA.pem
AWS_CERTIFICATE=certs/device-certificate.pem.crt
AWS_PRIVATE_KEY=certs/private-key.pem

# System identification
DEVICE_ID=aquasense-pro-001
THING_NAME=AquaSensePro_001

# Sensor calibration defaults (override with empirical values)
TDS_CALIBRATION_FACTOR=21.34  # Example: V = factor * TDS + offset; adjust per real calibration
PH_CALIBRATION_VOLTAGE_7=3.5  # pH 7.0 reference voltage at 25°C
PH_CALIBRATION_FACTOR=-5.70  # Slope factor: ph_act = -5.70 * volt + calibration_value
TURBIDITY_CALIBRATION_A=0.01  # ADC-to-NTU linear coefficient (replace with real NTU calibration)
TURBIDITY_CALIBRATION_B=0.0  # ADC-to-NTU linear offset
UV254_CALIBRATION_A=0.123  # UV254 absorbance to DOC proxy coefficient (simulation only)
UV254_CALIBRATION_B=0.0  # UV254 absorbance to DOC proxy offset (simulation only)

# Dosing setpoints (configurable via MQTT or web UI; these are defaults)
MINERAL_CA_SETPOINT_MGL=30  # Max calcium dosage setpoint (mg/L)
MINERAL_MG_SETPOINT_MGL=20  # Max magnesium dosage setpoint (mg/L)

# Fault and safety defaults
PRESSURE_INTERLOCK_BAR=4.5  # Pressure threshold for inlet solenoid isolation
UV_C_SERVICE_HOURS=8000  # UV-C lamp replacement interval (hours)
FRESH_READING_TIMEOUT_S=90  # Stale reading threshold before sensor fault

# Simulation mode (set to 0 or omit for real hardware mode)
ENABLE_SIMULATION=0  # Set to 1 to use mock sensor data instead of requiring hardware